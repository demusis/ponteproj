<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app goes to the cloud backup or to another phone (the library, the Drive
     file address and the stored passphrase stay on this device). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
    </device-transfer>
</data-extraction-rules>
